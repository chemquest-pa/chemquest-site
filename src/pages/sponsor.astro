---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { links, sponsors } from '../site';
import kidsWithBag from '../assets/photos/kids-with-bag.webp';

const pays = [
  'Supplies for hands-on experiments, so every event stays free for families',
  'Learning materials for kids of all backgrounds and abilities',
  'More events, in Glen Mills and beyond',
];
// Each tier looks a little bolder than the one before it.
const tiers = [
  { name: 'Bronze', min: 50, color: '#d9a273', perks: ['Featured on our social media (1,000+ followers)', 'Small logo on all our emails'] },
  { name: 'Silver', min: 150, color: '#b9c0c8', perks: ['Featured on our social media', 'Medium logo on all our emails', 'Thank-you mention on our website'] },
  { name: 'Gold', min: 200, color: 'var(--yellow)', perks: ['Dedicated social media spotlight post', 'Large logo on all our emails', 'Mention on our website', 'Company profile in our newsletter'] },
];
const sponsorMail = `mailto:${links.email}?subject=${encodeURIComponent('Sponsoring ChemQuest')}`;
// The Venmo wordmark (Simple Icons, CC0).
const venmoLogo = 'M21.772 13.119c-.267 0-.381-.251-.38-.655 0-.533.121-1.575.712-1.575.267 0 .357.243.357.598 0 .533-.13 1.632-.689 1.632Zm.502-3.377c-1.677 0-2.405 1.285-2.405 2.658 0 1.042.421 1.874 1.693 1.874 1.717 0 2.438-1.406 2.438-2.763 0-1.025-.462-1.769-1.726-1.769Zm-3.833 0c-.558 0-.964.17-1.393.477-.154-.275-.462-.477-.932-.477-.542 0-.947.219-1.247.437l-.04-.364H13.54l-.688 4.354h1.506l.479-3.053c.129-.065.323-.154.518-.154.145 0 .267.049.267.267 0 .056-.016.145-.024.218l-.429 2.722h1.498l.478-3.053c.138-.073.324-.154.51-.154.146 0 .268.049.268.267 0 .056-.017.145-.025.218l-.429 2.722h1.499l.461-2.908c.025-.153.049-.388.049-.549 0-.582-.267-.97-1.037-.97Zm-6.871 0c-.575 0-.98.219-1.287.421l-.017-.348H8.962l-.689 4.354H9.78l.478-3.053c.13-.065.324-.154.518-.154.147 0 .268.049.268.242 0 .081-.024.227-.032.299l-.422 2.666h1.499l.462-2.908c.024-.153.049-.388.049-.549 0-.582-.268-.97-1.03-.97Zm-5.631 1.834c.041-.485.413-.824.697-.824.162 0 .299.097.299.291 0 .404-.713.533-.996.533Zm.843-1.834c-1.604 0-2.382 1.39-2.382 2.698 0 1.01.478 1.817 1.814 1.817.527 0 1.07-.113 1.418-.282l.186-1.26c-.494.25-.874.347-1.271.347-.365 0-.64-.194-.64-.687.826-.008 2.252-.347 2.252-1.453 0-.687-.494-1.18-1.377-1.18Zm-4.239.267c.089.186.146.412.146.743 0 .606-.429 1.494-.777 2.06l-.373-2.989L0 9.969l.705 4.2h1.757c.77-1.01 1.718-2.448 1.718-3.554 0-.347-.073-.622-.235-.889l-1.402.283Z';
---
<Base title="Sponsor & donate" description="Sponsor or donate to ChemQuest. Your support keeps our hands-on science events free for every family.">
  <PageHead title="Sponsor or donate" doodle="beaker">
    Families never pay for ChemQuest events. Sponsors and donors buy the supplies that make them possible.
  </PageHead>

  <section class="section" aria-labelledby="pays-h">
    <div class="wrap two-col">
      <div>
        <h2 id="pays-h">What your support pays for</h2>
        <ul class="pays">
          {pays.map((p) => <li>{p}</li>)}
        </ul>
      </div>
      <figure class="taped photo" style="--tilt:-2deg" data-reveal>
        <Image src={kidsWithBag} alt="Kids grinning and holding up the bag from their experiment." widths={[360, 540, 1600]} sizes="(min-width: 56rem) 22rem, 100vw" />
      </figure>
    </div>
  </section>

  <section id="tiers" class="section tiers-section" aria-labelledby="tiers-h">
    <div class="wrap">
      <h2 id="tiers-h">Sponsorship tiers</h2>
      <p>One-time sponsorships for businesses and organizations.</p>
      <ul class="tiers" data-stagger>
        {tiers.map((t) => (
          <li class:list={['tier', t.name.toLowerCase()]} style={`--metal:${t.color}`}>
            <h3>{t.name}</h3>
            <p class="amount">${t.min}+</p>
            <ul class="perks">{t.perks.map((p) => <li>{p}</li>)}</ul>
          </li>
        ))}
      </ul>
      <div class="actions">
        <a class="btn btn-primary" href={sponsorMail}>Email us to become a sponsor</a>
      </div>
      <p class="muted small more">Tell us which tier you'd like. We'll reply with next steps and ask for your logo.</p>
    </div>
  </section>

  <section class="section donate" aria-labelledby="donate-h">
    <div class="wrap donate-row">
      <div>
        <h2 id="donate-h">Donate any amount</h2>
        <p>Individuals can give on Venmo to <strong>{links.venmoHandle}</strong>.</p>
        <p class="tax">ChemQuest is a 501(c)(3) nonprofit, so donations are tax-deductible.</p>
      </div>
      <a class="btn btn-venmo" href={links.venmo}>
        Donate on
        <svg class="venmo" viewBox="0 9.7 24 4.7" role="img" aria-label="Venmo"><path d={venmoLogo} /></svg>
      </a>
    </div>
  </section>

  {sponsors.length > 0 && (
    <section class="section" aria-labelledby="thanks-h">
      <div class="wrap">
        <h2 id="thanks-h">Thank you to our sponsors</h2>
        <ul class="thanks">{sponsors.map((s) => <li>{s.url ? <a href={s.url}>{s.name}</a> : s.name}</li>)}</ul>
      </div>
    </section>
  )}
</Base>

<style>
  .two-col { display: grid; gap: 2.5rem; align-items: center; }
  @media (min-width: 56rem) { .two-col { grid-template-columns: 1fr 22rem; gap: 4rem; } }
  .pays { padding-left: 1.25rem; margin: 1rem 0 0; }
  .pays li { margin-bottom: 0.6rem; max-width: 36rem; }
  .pays li::marker { color: var(--green); }
  .photo img { aspect-ratio: 1; object-fit: cover; }

  /* Tiers climb like steps: each one bigger and bolder than the last. A band across the top,
     inside the border, is the tier's metal color. Point at a tier and it pops out a little. */
  .tiers-section { background: var(--surface); }
  .tiers { list-style: none; padding: 0; margin: 2rem 0 0; display: grid; gap: 1.25rem; }
  .tier {
    border: 1px solid var(--rule); border-radius: 8px; padding: 1.6rem 1.25rem 1rem;
    background: linear-gradient(var(--metal) 0 0) top / 100% 0.6rem no-repeat var(--bg);
  }
  .tier h3 { margin: 0; font-size: 1.5rem; }
  .amount { font-family: var(--slab); font-weight: 700; font-size: 2rem; line-height: 1; color: var(--green); margin: 0.2rem 0 0.9rem; }
  .perks { margin: 0; padding: 0.9rem 0 0 1.1rem; border-top: 1px solid var(--line); font-size: 1rem; }
  .perks li { margin-bottom: 0.4rem; }

  .silver { background-color: var(--surface); border-color: var(--text); border-width: 1.5px; }
  .silver h3 { font-size: 1.7rem; }
  .silver .amount { font-size: 2.35rem; }

  .gold { background-color: var(--yellow-tint); background-size: 100% 0.75rem; border-color: var(--text); border-width: 2px; padding: 1.9rem 1.5rem 1.25rem; }
  .gold h3 { font-size: 2rem; }
  .gold .amount { font-size: 2.8rem; }
  .gold .perks { border-top-color: var(--rule); }

  @media (min-width: 56rem) {
    .tiers { grid-template-columns: 1fr 1fr 1.15fr; align-items: end; gap: 1.5rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .tier:hover { scale: 1.03; }
  }
  .more { margin-top: 0.75rem; }

  .donate { background: var(--green-tint); }
  .donate-row { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem 2rem; }
  .donate-row p { margin: 0; }
  .tax { margin-top: 0.4rem !important; font-size: 0.95rem; color: var(--muted); max-width: 36rem; }
  .btn-venmo { background: var(--venmo); color: #fff; gap: 0.45em; }
  .btn-venmo:hover { background: #005fb8; }
  .btn-venmo .venmo { width: auto; height: 0.95em; fill: currentColor; translate: 0 0.08em; }
  .thanks { columns: 14rem; padding-left: 1.25rem; }
</style>
