---
// Line drawings of lab equipment, in one "lab manual" style: thin ink lines, flat washes of color.
// Each one traces itself when it scrolls into view, and each is a little toy: click it and it does
// its thing (the flask swirls, the molecule spins, the microscope focuses…). The Base layout's
// script adds the "play" class on click and removes it when the animation is over.
export type DoodleKind =
  | 'flask' | 'tubes' | 'dropper' | 'beaker' | 'molecule' | 'microscope' | 'telescope' | 'cans'
  | 'magnifier' | 'lava' | 'spill' | 'atom' | 'thermometer' | 'goggles';
interface Props { kind: DoodleKind; class?: string }
const { kind, class: cls } = Astro.props;

// What clicking does, for screen readers and the hover tooltip.
const labels: Record<DoodleKind, string> = {
  flask: 'Swirl the flask', tubes: 'Shake the test tubes', dropper: 'Squeeze the dropper', beaker: 'Stir the beaker',
  molecule: 'Spin the molecule', microscope: 'Focus the microscope', telescope: 'Aim the telescope', cans: 'Ping the tin-can phone',
  magnifier: 'Look around with the magnifying glass', lava: 'Start the lava lamp', spill: 'Stand the beaker back up',
  atom: 'Spin the atom', thermometer: 'Warm up the thermometer', goggles: 'Polish the safety goggles',
};

const r1 = (n: number) => +n.toFixed(1);
// Hexagon ring like the one in the ChemQuest logo.
const hex = [0, 1, 2, 3, 4, 5].map((k) => {
  const a = (Math.PI / 3) * k - Math.PI / 2;
  return [r1(80 + 32 * Math.cos(a)), r1(70 + 32 * Math.sin(a))];
});
const clip = `lens-${Math.random().toString(36).slice(2, 8)}`;
---
<button type="button" class:list={['toy', cls]} aria-label={labels[kind]} title={labels[kind]}>

{kind === 'flask' && (
  <svg class="doodle flask" viewBox="20 40 160 210" aria-hidden="true" data-reveal>
    <g class="swirl">
      <path class="fl g" d="M62 197h76l24 35q5 9-6 9H44q-11 0-6-9z" />
      <path class="ln" pathLength="1" d="M63 196q37 5 74 0" />
      <path class="ln" pathLength="1" d="M84 110h32M88 110v44L36 232q-6 13 8 13h112q14 0 8-13L112 154v-44" />
      <path class="ln thin" pathLength="1" d="M75 176h9M65 191h9M55 206h9M45 221h9" />
      <path class="ln hl" pathLength="1" d="M94 116v32" />
      <text class="fl tag" x="100" y="226" text-anchor="middle">250 mL</text>
    </g>
    <circle class="bub b1" cx="96" cy="212" r="5" />
    <circle class="bub b2" cx="105" cy="222" r="3.5" />
    <circle class="bub b3" cx="99" cy="206" r="4" />
  </svg>
)}

{kind === 'tubes' && (
  <svg class="doodle tubes" viewBox="0 0 160 130" aria-hidden="true" data-reveal>
    <g class="rack">
      {[[40, 60, 'g'], [66, 44, 'p'], [92, 76, 'y'], [118, 54, 'gt']].map(([x, lvl, c], i) => (
        <g class="tube" style={`--i:${i}`}>
          <path class:list={['fl', c]} d={`M${+x - 5.5} ${lvl}h11v${92 - +lvl}a5.5 5.5 0 0 1-11 0z`} />
          <path class="ln" pathLength="1" d={`M${+x - 9} 12h18M${+x - 7} 12v80a7 7 0 0 0 14 0V12`} />
        </g>
      ))}
      <path class="fl w" d="M10 40h140v10H10z" />
      <path class="ln" pathLength="1" d="M10 40h140v10H10zM18 50v62M142 50v62M10 112h140v8H10z" />
    </g>
  </svg>
)}

{kind === 'dropper' && (
  <svg class="doodle dropper" viewBox="0 0 160 140" aria-hidden="true" data-reveal>
    <ellipse class="fl p soft" cx="80" cy="119" rx="40" ry="6" />
    <path class="ln" pathLength="1" d="M20 118a60 14 0 1 0 120 0a60 14 0 1 0-120 0M26 118a54 10 0 0 0 108 0" />
    <g class="bulb">
      <path class="fl p" d="M69 22a11 13 0 0 1 22 0v12H69z" />
      <path class="ln" pathLength="1" d="M69 34V22a11 13 0 0 1 22 0v12z" />
    </g>
    <path class="ln" pathLength="1" d="M72 34h16v6H72zM75 40v42l5 12 5-12V40" />
    <path class="fl p" d="M76 70h8v12l-4 10-4-10z" />
    <path class="drop" d="M80 99q4 6 0 9q-4-3 0-9z" />
    <ellipse class="ripple" cx="80" cy="119" rx="10" ry="2.5" />
  </svg>
)}

{kind === 'beaker' && (
  <svg class="doodle beaker" viewBox="0 0 160 140" aria-hidden="true" data-reveal>
    <g class="liquid">
      <path class="fl y soft" d="M47 66h66v56q0 5-5 5H52q-5 0-5-5z" />
      <path class="ln" pathLength="1" d="M47 66q33 4 66 0" />
    </g>
    <circle class="bub b1" cx="62" cy="116" r="3.5" />
    <circle class="bub b2" cx="98" cy="112" r="3" />
    <circle class="bub b3" cx="80" cy="120" r="4" />
    <path class="ln rod" pathLength="1" d="M70 6 96 112" />
    <path class="ln" pathLength="1" d="M36 18q6 2 8 6v98q0 8 8 8h56q8 0 8-8V20h4" />
    <path class="ln thin" pathLength="1" d="M116 46h-10M116 66h-14M116 86h-10M116 106h-14" />
  </svg>
)}

{kind === 'molecule' && (
  <svg class="doodle molecule" viewBox="0 0 160 140" aria-hidden="true" data-reveal>
    <g class="spin">
      <path class="ln" pathLength="1" d={`M${hex.map((p) => p.join(' ')).join('L')}Z`} />
      <path class="ln thin" pathLength="1" d={`M${hex.map(([x, y]) => [r1(80 + (x - 80) * 0.72), r1(70 + (y - 70) * 0.72)].join(' ')).join('L')}Z`} />
      <path class="ln" pathLength="1" d={`M${hex[0].join(' ')}V12M${hex[2].join(' ')}l26 15M${hex[4].join(' ')}l-26 15`} />
      {hex.map(([x, y], i) => <circle class:list={['fl', 'atom', i % 2 ? 'p' : 'g']} cx={x} cy={y} r="6" />)}
      <circle class="fl atom y" cx="80" cy="12" r="7" />
    </g>
  </svg>
)}

{kind === 'microscope' && (
  <svg class="doodle microscope" viewBox="0 0 140 150" aria-hidden="true" data-reveal>
    <path class="fl pt" d="M34 126h72v10H34z" />
    <path class="ln" pathLength="1" d="M26 136h88M34 136v-10h72v10" />
    <path class="ln" pathLength="1" d="M94 126C110 104 102 70 70 58M84 126C98 106 92 80 64 68" />
    <path class="fl w" d="M32 96h66v6H32z" />
    <path class="ln" pathLength="1" d="M32 96h66v6H32z" />
    <path class="fl pt" d="M50 92h30v4H50z" />
    <g class="tube">
      <g transform="rotate(-20 64 92)">
        <path class="fl w" d="M54 30h20v50H54z" />
        <path class="fl g" d="M51 16h26v14H51z" />
        <path class="ln" pathLength="1" d="M54 30h20v50H54zM51 16h26v14H51zM59 80h10v9H59z" />
      </g>
    </g>
    <g class="knob">
      <path class="fl w" d="M92 84a6 6 0 1 0 12 0a6 6 0 1 0-12 0" />
      <path class="ln" pathLength="1" d="M92 84a6 6 0 1 0 12 0a6 6 0 1 0-12 0M98 84h5" />
    </g>
    <path class="spark" d="M22 82v10M17 87h10" />
  </svg>
)}

{kind === 'telescope' && (
  <svg class="doodle telescope" viewBox="0 0 160 130" aria-hidden="true" data-reveal>
    <path class="ln" pathLength="1" d="M78 70 50 124M78 70v56M78 70l28 54" />
    <g class="scope">
      <g transform="rotate(-24 78 64)">
        <path class="fl w" d="M28 54h86v20H28z" />
        <path class="fl g" d="M114 50h18v28h-18z" />
        <path class="fl y" d="M66 52h8v24h-8z" />
        <path class="ln" pathLength="1" d="M28 54h86v20H28zM14 58h14v12H14zM114 50h18v28h-18zM66 52h8v24h-8z" />
      </g>
    </g>
    <path class="ln thin star s1" pathLength="1" d="M132 10v12M126 16h12" />
    <path class="ln thin star s2" pathLength="1" d="M150 34v8M146 38h8" />
  </svg>
)}

{kind === 'cans' && (
  <svg class="doodle cans" viewBox="0 0 200 120" aria-hidden="true" data-reveal>
    <g class="can left">
      <path class="fl pt" d="M22 46h30a6 16 0 0 1 0 32H22z" />
      <path class="ln" pathLength="1" d="M22 46h30a6 16 0 0 1 0 32H22M16 62a6 16 0 1 0 12 0a6 16 0 1 0-12 0M34 46v32M42 46v32" />
    </g>
    <g class="can right">
      <path class="fl gt" d="M148 46h30v32h-30a6 16 0 0 1 0-32z" />
      <path class="ln" pathLength="1" d="M178 46h-30a6 16 0 0 0 0 32h30M172 62a6 16 0 1 0 12 0a6 16 0 1 0-12 0M166 46v32M158 46v32" />
    </g>
    <path class="ln thin string" pathLength="1" d="M58 62Q100 92 142 62" />
  </svg>
)}

{kind === 'magnifier' && (
  <svg class="doodle magnifier" viewBox="0 0 140 140" aria-hidden="true" data-reveal>
    <g class="look">
      <circle class="fl pt soft" cx="58" cy="58" r="31" />
      <path class="ln" pathLength="1" d="M22 58a36 36 0 1 0 72 0a36 36 0 1 0-72 0M27 58a31 31 0 1 0 62 0a31 31 0 1 0-62 0" />
      <path class="ln thin" pathLength="1" d="M40 44a22 22 0 0 1 14-12" />
      <g transform="rotate(45 103 103)">
        <path class="fl y" d="M84 96h44v14H84z" />
        <path class="ln" pathLength="1" d="M84 96h44v14H84z" />
      </g>
    </g>
  </svg>
)}

{kind === 'lava' && (
  <svg class="doodle lava" viewBox="0 0 120 170" aria-hidden="true" data-reveal>
    <path class="fl p soft" d="M37 122h46v32q0 6-6 6H43q-6 0-6-6z" />
    <path class="fl y soft" d="M37 66h46v56H37z" />
    <circle class="fl p blob b1" cx="52" cy="104" r="6" />
    <circle class="fl p blob b2" cx="68" cy="88" r="5" />
    <circle class="fl p blob b3" cx="58" cy="76" r="3.5" />
    <path class="ln thin" pathLength="1" d="M37 66h46M37 122h46" />
    <path class="ln" pathLength="1" d="M50 14v16q0 6-6 10l-4 3q-5 4-5 11v100q0 8 8 8h34q8 0 8-8V54q0-7-5-11l-4-3q-6-4-6-10V14z" />
    <path class="fl k" d="M47 4h26v10H47z" />
  </svg>
)}

{kind === 'spill' && (
  <svg class="doodle spill" viewBox="14 22 186 94" aria-hidden="true" data-reveal>
    <path class="fl g soft puddle" d="M104 100q20-6 44-3t44 4q2 7-28 9t-58-2q-6-4-2-8z" />
    <g class="slide">
      <g transform="rotate(84 70 64)">
        <g class="tipper">
          <path class="ln" pathLength="1" d="M36 18q6 2 8 6v78q0 8 8 8h40q8 0 8-8V20h4" />
          <path class="ln thin" pathLength="1" d="M100 46h-10M100 66h-14M100 86h-10" />
        </g>
      </g>
    </g>
  </svg>
)}

{kind === 'atom' && (
  <svg class="doodle atom-art" viewBox="0 0 160 140" aria-hidden="true" data-reveal>
    <g class="orbits">
      <ellipse class="ln" pathLength="1" cx="80" cy="70" rx="58" ry="20" />
      <ellipse class="ln" pathLength="1" cx="80" cy="70" rx="58" ry="20" transform="rotate(60 80 70)" />
      <ellipse class="ln" pathLength="1" cx="80" cy="70" rx="58" ry="20" transform="rotate(-60 80 70)" />
      <circle class="fl atom g" cx="22" cy="70" r="5" />
      <circle class="fl atom p" cx="109" cy="120.2" r="5" />
      <circle class="fl atom y" cx="109" cy="19.8" r="5" />
    </g>
    <g class="nucleus">
      <circle class="fl atom y" cx="76" cy="67" r="8" />
      <circle class="fl atom p" cx="85" cy="74" r="7" />
    </g>
  </svg>
)}

{kind === 'thermometer' && (
  <svg class="doodle thermometer" viewBox="0 0 80 170" aria-hidden="true" data-reveal>
    <rect class="fl w" x="30" y="10" width="20" height="125" rx="10" />
    <rect class="fl p merc" x="35" y="30" width="10" height="110" rx="5" />
    <circle class="fl p" cx="40" cy="142" r="11" />
    <path class="ln" pathLength="1" d="M30 128V20a10 10 0 0 1 20 0v108a16 16 0 1 1-20 0z" />
    <path class="ln thin" pathLength="1" d="M50 34h-7M50 54h-5M50 74h-7M50 94h-5M50 114h-7" />
    <path class="ln thin heat" pathLength="1" d="M10 150q4-5 0-10t0-10M70 150q4-5 0-10t0-10" />
  </svg>
)}

{kind === 'goggles' && (
  <svg class="doodle goggles" viewBox="0 0 180 100" aria-hidden="true" data-reveal>
    <defs>
      <clipPath id={clip}><circle cx="55" cy="52" r="26" /><circle cx="125" cy="52" r="26" /></clipPath>
    </defs>
    <g class="specs">
      <circle class="fl pt" cx="55" cy="52" r="26" />
      <circle class="fl gt" cx="125" cy="52" r="26" />
      <g clip-path={`url(#${clip})`}><path class="glint" d="M20 88 70 8M36 94 86 14" /></g>
      <path class="ln" pathLength="1" d="M27 52a28 28 0 1 0 56 0a28 28 0 1 0-56 0M97 52a28 28 0 1 0 56 0a28 28 0 1 0-56 0" />
      <path class="ln" pathLength="1" d="M83 47q7-7 14 0M27 50H8q-4 0-4 5M153 50h19q4 0 4 5" />
    </g>
  </svg>
)}

</button>

<style>
  .doodle { display: block; overflow: visible; }
  .ln { fill: none; stroke: var(--text); stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; }
  .thin { stroke-width: 1.4; }
  .hl { stroke: var(--rule); stroke-width: 1.6; }
  .fl { stroke: none; }
  .atom { stroke: var(--text); stroke-width: 2; }
  .g { fill: var(--green-mid); } .p { fill: var(--purple-mid); } .y { fill: var(--yellow); }
  .gt { fill: var(--green-tint); } .pt { fill: var(--purple-tint); } .w { fill: var(--surface); } .k { fill: var(--text); }
  .soft { opacity: 0.6; }
  .tag { fill: var(--muted); font-size: 10px; font-weight: 600; font-family: var(--sans); }

  /* Parts that only show up while a toy is playing. */
  .bub { fill: var(--surface); stroke: var(--text); stroke-width: 1.3; opacity: 0; }
  .drop, .ripple, .spark, .heat, .glint { opacity: 0; }
  .drop { fill: var(--purple-mid); }
  .ripple { fill: none; stroke: var(--text); stroke-width: 1.4; }
  .spark { fill: none; stroke: var(--purple); stroke-width: 2; stroke-linecap: round; }
  .glint { fill: none; stroke: var(--surface); stroke-width: 6; stroke-linecap: round; }

  /* Pivot points: each moving part turns around the spot a real one would. */
  .swirl, .liquid { transform-box: fill-box; transform-origin: 50% 100%; }
  .tube, .can, .star, .bub, .blob, .drop, .ripple, .spark, .nucleus { transform-box: fill-box; transform-origin: 50% 50%; }
  .tubes .tube { transform-origin: 50% 32%; }
  .bulb, .merc { transform-box: fill-box; transform-origin: 50% 100%; }
  .merc { transform: scaleY(0.45); }
  .string { transform-box: fill-box; transform-origin: 50% 0%; }
  .tipper { transform-box: fill-box; transform-origin: 94% 100%; }
  .puddle { transform-box: fill-box; transform-origin: 0% 50%; }
  .spin, .orbits, .look, .knob, .scope, .specs { transform-box: view-box; }
  .spin { transform-origin: 80px 70px; }
  .orbits { transform-origin: 80px 70px; }
  .look { transform-origin: 70px 70px; }
  .knob { transform-origin: 98px 84px; }
  .scope { transform-origin: 78px 66px; }
  .specs { transform-origin: 90px 52px; }

  @media (prefers-reduced-motion: no-preference) {
    /* Lines trace themselves, then the color washes fade in. Once. */
    :global(.js-reveal) .doodle[data-reveal] { opacity: 1; translate: none; }
    :global(.js-reveal) .doodle path.ln, :global(.js-reveal) .doodle ellipse.ln { stroke-dasharray: 1; stroke-dashoffset: 1; transition: stroke-dashoffset 1.6s var(--ease); }
    :global(.js-reveal) .doodle.is-in .ln { stroke-dashoffset: 0; }
    :global(.js-reveal) .doodle :is(.fl, .atom) { opacity: 0; transition: opacity 700ms ease 700ms; }
    :global(.js-reveal) .doodle.is-in :is(.fl, .atom) { opacity: 1; }
    :global(.js-reveal) .doodle.is-in .soft { opacity: 0.6; }
    :global(.js-reveal) .doodle .merc { transition: opacity 700ms ease 700ms, transform 1.2s var(--ease) 900ms; transform: scaleY(0.1); }
    :global(.js-reveal) .doodle.is-in .merc { transform: scaleY(0.45); }

    /* ---- The toys. Everything eases in and out; nothing explodes. ---- */
    .play .swirl { animation: toy-swirl 1.3s ease-in-out; }
    .play .flask .bub { animation: toy-bubble 1.5s ease-out 0.5s; }
    .play .flask .b2 { animation-delay: 0.75s; }
    .play .flask .b3 { animation-delay: 1s; }

    .play .rack { animation: toy-nudge 700ms ease-in-out; }
    .play .tubes .tube { animation: toy-clink 900ms ease-in-out calc(var(--i) * 90ms); }

    .play .bulb { animation: toy-squeeze 900ms ease-in-out; }
    .play .drop { animation: toy-drop 1.2s ease-in 0.25s; }
    .play .ripple { animation: toy-ripple 1.6s ease-out 0.25s; }

    .play .rod { animation: toy-stir 650ms ease-in-out 2; }
    .play .liquid { animation: toy-slosh 1.3s ease-in-out; }
    .play .beaker .bub { animation: toy-fizz 1.4s ease-out 0.3s; }
    .play .beaker .b2 { animation-delay: 0.55s; }
    .play .beaker .b3 { animation-delay: 0.8s; }

    .play .spin { animation: toy-turn 1.4s cubic-bezier(.65, 0, .35, 1); }

    .play .microscope .tube { animation: toy-focus 1.4s ease-in-out; }
    .play .knob { animation: toy-knob 1.4s ease-in-out; }
    .play .spark { animation: toy-spark 900ms ease-in-out 0.8s; }

    .play .scope { animation: toy-aim 1.6s ease-in-out; }
    .play .star { animation: toy-twinkle 900ms ease-in-out 0.6s; }
    .play .s2 { animation-delay: 0.85s; }

    .play .can.left { animation: toy-wiggle 700ms ease-in-out; }
    .play .can.right { animation: toy-wiggle 700ms ease-in-out 0.45s; }
    .play .string { animation: toy-twang 900ms ease-in-out 0.2s; }

    .play .look { animation: toy-look 1.6s ease-in-out; }

    .play .blob { animation: toy-rise 2.6s ease-in-out; }
    .play .b2.blob { animation-name: toy-rise-2; animation-delay: 0.3s; }
    .play .b3.blob { animation-name: toy-rise-3; animation-delay: 0.55s; }

    .play .tipper { animation: toy-standup 2.6s; }
    .play .slide { animation: toy-slide 2.6s; }
    .play .puddle { animation: toy-puddle 2.6s; }

    .play .orbits { animation: toy-turn 1.5s cubic-bezier(.65, 0, .35, 1); }
    .play .nucleus { animation: toy-pulse 1.5s ease-in-out; }

    .play .merc { animation: toy-warm 2.2s ease-in-out; }
    .play .heat { animation: toy-heat 2.2s ease-in-out; }

    .play .glint { animation: toy-glint 1.1s ease-in-out; }
    .play .specs { animation: toy-tilt 1.1s ease-in-out; }
  }

  @keyframes toy-swirl { 18% { transform: rotate(-9deg); } 40% { transform: rotate(8deg); } 62% { transform: rotate(-5deg); } 82% { transform: rotate(2deg); } }
  @keyframes toy-bubble { 0% { opacity: 0; transform: translateY(0); } 15% { opacity: 1; } 80% { opacity: 1; } 100% { opacity: 0; transform: translateY(-150px); } }
  @keyframes toy-nudge { 25% { transform: translateX(-4px); } 60% { transform: translateX(3px); } }
  @keyframes toy-clink { 25% { transform: rotate(-7deg); } 55% { transform: rotate(5deg); } 80% { transform: rotate(-2deg); } }
  @keyframes toy-squeeze { 30%, 55% { transform: scale(1.14, 0.74); } }
  @keyframes toy-drop { 0% { opacity: 0; transform: translateY(-8px); } 20% { opacity: 1; transform: translateY(-8px); } 75% { opacity: 1; transform: translateY(12px); } 85%, 100% { opacity: 0; transform: translateY(13px); } }
  @keyframes toy-ripple { 0%, 55% { opacity: 0; transform: scale(0.3); } 65% { opacity: 1; } 100% { opacity: 0; transform: scale(2.2); } }
  @keyframes toy-stir { 25% { transform: translate(6px, 2px); } 50% { transform: translate(0, 4px); } 75% { transform: translate(-6px, 2px); } }
  @keyframes toy-slosh { 30% { transform: skewX(-4deg); } 65% { transform: skewX(3deg); } }
  @keyframes toy-fizz { 0% { opacity: 0; transform: translateY(0); } 20% { opacity: 1; } 85% { opacity: 1; } 100% { opacity: 0; transform: translateY(-46px); } }
  @keyframes toy-turn { to { transform: rotate(360deg); } }
  @keyframes toy-focus { 40%, 65% { transform: translateY(6px); } }
  @keyframes toy-knob { 40%, 65% { transform: rotate(240deg); } }
  @keyframes toy-spark { 0%, 100% { opacity: 0; transform: scale(0.2) rotate(0); } 50% { opacity: 1; transform: scale(1.2) rotate(45deg); } }
  @keyframes toy-aim { 35% { transform: rotate(-12deg); } 70% { transform: rotate(5deg); } }
  @keyframes toy-twinkle { 50% { transform: scale(1.8) rotate(45deg); } }
  @keyframes toy-wiggle { 30% { transform: rotate(-9deg); } 70% { transform: rotate(6deg); } }
  @keyframes toy-twang { 20% { transform: scaleY(-0.6); } 45% { transform: scaleY(0.7); } 70% { transform: scaleY(-0.3); } }
  @keyframes toy-look { 25% { transform: translate(-9px, -4px) rotate(-6deg); } 50% { transform: translate(0, -9px); } 75% { transform: translate(9px, -4px) rotate(6deg); } }
  @keyframes toy-rise { 50% { transform: translateY(-40px) scale(0.9, 1.15); } }
  @keyframes toy-rise-2 { 50% { transform: translateY(-24px) scale(0.9, 1.15); } }
  @keyframes toy-rise-3 { 50% { transform: translateY(-12px) scale(1.2); } }
  @keyframes toy-standup {
